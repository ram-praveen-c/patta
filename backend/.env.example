# =======================================================
# Backend Environment Configuration (FastAPI)
# =======================================================

# Server Binding
PORT=8000
HOST=0.0.0.0

# CORS Allowed Frontend Origin(s)
# In development:
FRONTEND_URL=http://localhost:5173

# In production (comma-separated if multiple domains):
# FRONTEND_URL=https://landlens.vercel.app,https://yourcustomdomain.com

# Database & Storage (Optional: set custom paths for cloud persistent volumes)
# DATABASE_PATH=/data/land_intelligence.db
# MAPS_DIR=/data/uploads/maps
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
